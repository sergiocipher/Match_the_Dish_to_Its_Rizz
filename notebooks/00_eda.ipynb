   "source": [
    "# 00 – Exploratory Data Analysis\n",
    "\n",
    "**Phase 0 exit gate:** You can state the category count, gallery sizes, R values and which classes are confusable, and have seen real images.\n",
    "\n",
    "**Deliverables:** This notebook + a short "data facts" section in `README.md`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Standard notebook header (AGENTS.md §3.2) ──────────────────────────────\n",
    "import sys, random, os\n",
    "import numpy as np\n",
    "import torch\n",
    "\n",
    "sys.path.insert(0, \"..\")                         # local: project root\n",
    "sys.path.append(\"/kaggle/input/datasets/somyajitsaha/food-retrieval-src\")  # Kaggle: no-op locally\n",
    "\n",
    "from src.config import DATA_DIR, OUT_DIR, seed_everything, load_config, ensure_dirs\n",
    "\n",
    "SEED = 42\n",
    "seed_everything(SEED)\n",
    "\n",
    "import torchvision, sklearn\n",
    "print({k: v.__version__ for k, v in dict(\n",
    "    torch=torch, torchvision=torchvision, sklearn=sklearn, numpy=np).items()})\n",
    "print(\"GPU:\", torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"CPU\")\n",
    "print(\"DATA_DIR:\", DATA_DIR)\n",
    "print(\"OUT_DIR: \", OUT_DIR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "from src.data import load_csvs\n",
    "\n",
    "dfs = load_csvs(DATA_DIR)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 1. Category count & gallery sizes"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "train       = dfs[\"train\"]\n",
    "val_gallery = dfs[\"val_gallery\"]\n",
    "test_gallery= dfs[\"test_gallery\"]\n",
    "val_queries = dfs[\"val_queries\"]\n",
    "test_queries= dfs[\"test_queries\"]\n",
    "meta        = dfs[\"category_metadata\"]\n",
    "val_gt      = dfs[\"val_gt\"]\n",
    "\n",
    "n_train_cats = train[\"category_id\"].nunique()\n",
    "n_meta_cats  = meta[\"category_id\"].nunique()\n",
    "n_val_queries= len(val_queries)\n",
    "n_test_queries = len(test_queries)\n",
    "\n",
    "print(f\"Train categories:         {n_train_cats}\")\n",
    "print(f\"Metadata categories:      {n_meta_cats}\")\n",
    "print(f\"Train gallery images:     {len(train)}\")\n",
    "print(f\"Val gallery images:       {len(val_gallery)}\")\n",
    "print(f\"Test gallery images:      {len(test_gallery)}\")\n",
    "print(f\"Val queries:              {n_val_queries}\")\n",
    "print(f\"Test queries:             {n_test_queries}\")\n",
    "print(f\"Test queries / category:  {n_test_queries / n_meta_cats:.2f}\")\n",
    "print()\n",
    "print(\"TODO: confirm 100 or 101 categories?\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 2. Class balance in train gallery"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "counts = train[\"category_id\"].value_counts().sort_index()\n",
    "print(f\"Images per category – min={counts.min()}, max={counts.max()}, mean={counts.mean():.1f}\")\n",
    "\n",
    "plt.figure(figsize=(14, 3))\n",
    "plt.bar(range(len(counts)), counts.values)\n",
    "plt.xlabel(\"category index (sorted by id)\")\n",
    "plt.ylabel(\"# images\")\n",
    "plt.title(\"Train gallery – images per category\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"../reports/figures/train_class_balance.png\", dpi=100)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 3. Image size distribution"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "from PIL import Image\n",
    "from src.data import image_dir, safe_open_rgb\n",
    "import random\n",
    "\n",
    "train_img_dir = image_dir(DATA_DIR, \"train\")\n",
    "sample_ids = train[\"image_id\"].sample(200, random_state=42).tolist()\n",
    "\n",
    "widths, heights = [], []\n",
    "modes = []\n",
    "for img_id in sample_ids:\n",
    "    p = train_img_dir / f\"{img_id}.jpg\"\n",
    "    if p.exists():\n",
    "        img = Image.open(p)\n",
    "        widths.append(img.width)\n",
    "        heights.append(img.height)\n",
    "        modes.append(img.mode)\n",
    "\n",
    "print(f\"Width  – min={min(widths)}, max={max(widths)}, mean={sum(widths)/len(widths):.0f}\")\n",
    "print(f\"Height – min={min(heights)}, max={max(heights)}, mean={sum(heights)/len(heights):.0f}\")\n",
    "print(f\"Modes (non-RGB): {set(m for m in modes if m != 'RGB')}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 4. Confusable groups"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Hard categories per AGENTS.md §1.3\n",
    "CONFUSABLE_KEYWORDS = {\n",
    "    \"pasta\": [\"spaghetti\", \"penne\", \"lasagna\", \"ravioli\", \"fettuccine\", \"tagliatelle\",\n",
    "               \"linguine\", \"rigatoni\", \"pappardelle\", \"tortellini\", \"carbonara\", \"bolognese\"],\n",
    "    \"cake\":  [\"cake\", \"cheesecake\", \"tiramisu\", \"brownie\", \"muffin\", \"cupcake\"],\n",
    "    \"rice\":  [\"rice\", \"risotto\", \"fried rice\", \"paella\", \"pilaf\", \"congee\"],\n",
    "    \"noodle_soup\": [\"ramen\", \"pho\", \"noodle soup\", \"udon\", \"soba\", \"laksa\"],\n",
    "    \"beef\":  [\"steak\", \"beef\", \"ribeye\", \"sirloin\", \"brisket\", \"filet\"],\n",
    "}\n",
    "\n",
    "cat_names = meta[\"category_name\"].str.lower().tolist()\n",
    "for group, keywords in CONFUSABLE_KEYWORDS.items():\n",
    "    matched = [n for n in cat_names if any(kw in n for kw in keywords)]\n",
    "    print(f\"{group:15s}: {matched}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 5. Label noise inspection (random sample per class)"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualise 8 images from 3 categories; look for obviously wrong labels\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "spot_check_cats = meta[\"category_id\"].sample(3, random_state=7).tolist()\n",
    "\n",
    "for cat_id in spot_check_cats:\n",
    "    cat_name = meta.loc[meta[\"category_id\"] == cat_id, \"category_name\"].values[0]\n",
    "    imgs_ids = train.loc[train[\"category_id\"] == cat_id, \"image_id\"].sample(\n",
    "        min(8, (train[\"category_id\"] == cat_id).sum()), random_state=42).tolist()\n",
    "\n",
    "    fig, axes = plt.subplots(1, len(imgs_ids), figsize=(2 * len(imgs_ids), 2.5))\n",
    "    fig.suptitle(f\"{cat_name} (id={cat_id})\", fontsize=10)\n",
    "    for ax, img_id in zip(axes, imgs_ids):\n",
    "        p = train_img_dir / f\"{img_id}.jpg\"\n",
    "        if p.exists():\n",
    "            ax.imshow(safe_open_rgb(p))\n",
    "        ax.axis(\"off\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 6. Validation ground truth sanity check"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.data import parse_val_ground_truth\n",
    "\n",
    "gt = parse_val_ground_truth(val_gt)\n",
    "val_gallery_ids = set(val_gallery[\"image_id\"].tolist())\n",
    "\n",
    "r_values = [len(ids) for ids in gt.values()]\n",
    "print(f\"Val queries: {len(gt)}\")\n",
    "print(f\"R values – min={min(r_values)}, max={max(r_values)}, mean={sum(r_values)/len(r_values):.1f}\")\n",
    "\n",
    "# All relevant IDs must be in val gallery\n",
    "bad = [(qid, [i for i in ids if i not in val_gallery_ids])\n",
    "       for qid, ids in gt.items() if any(i not in val_gallery_ids for i in ids)]\n",
    "print(f\"Queries with GT IDs not in val gallery: {len(bad)}\")\n",
    "assert len(bad) == 0, f\"GT leak: {bad[:3]}\""
   ]
  },
  {
